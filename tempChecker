<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
    <title>Vibe Check</title>
</head>

<body id="body">
    <div class="mainContainer">
        <div>
            <h1 id="title">Enter the temperature <br> to check the <span id="vibe">vibe!</span></h1>
        </div>
        <form>
            <input type="text" id="temp" maxlength="3" placeholder="Enter Temp. Here" inputmode="numeric" required>
            <button type="submit" id="btn" onclick="clickBtn()">Check Vibe :)</button><br><br><br>
            
        </form>
    </div>


    <script src="script.js"></script>
</body>

</html>


body {
    height: 100vh;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background-image: url(purp\ bg.jpg);
    background-size: cover;
    
}

.mainContainer {
    background-color: rgb(197, 156, 228);
    width: 400px;
    height: 300px;
    border-radius: 30px;
    border: 10px rgb(230, 223, 241) solid;
}

h1 {
    margin: 30px 100px;
    font-size: 20px;
    color: rgb(230, 227, 240);
    font-family: sans;
}

#temp,
#btn {
    margin: 50px 10px 50px 100px;
    display: block;


}

#temp{
    font-size: 20px;
    border-radius: 30px;
    padding: 15px;
    border: 3px solid rgb(178, 117, 235);

}

#temp:hover {
    background-color: rgb(223, 205, 240);
}

#btn {
    margin: 20px 150px 0px;
    border: 5px solid rgb(185, 108, 213);
    border-radius: 10px;
    background-color: rgb(163, 85, 236);
    padding: 5px;
    color: rgb(61, 56, 56);
}

.mainContainer {

    align-items: center;

}

#vibe {
    color: purple;
}

#btn:hover {
    background-color: rgb(204, 185, 223);
}

h1:hover {
    color: rgb(175, 105, 245);
}

const input = document.getElementById("temp");
const button = document.getElementById("btn");

function clickBtn(){
    const tempValue = input.value;
    const numTempValue = Number(tempValue);

    if(tempValue === ""){
        alert("PLEASE ENTER 🌡️TEMPERATURE!🌡️");
        return;

    } else if(isNaN(numTempValue)){
        alert("NUMBERS 👀 ONLY PLEASE!");
        return;
    } else if(tempValue >= 25){
        alert("SUMMER ☀️ VIBES!");
        return;
    } else if(tempValue < 25){
        alert("WINTER ❄️ VIBES!");
        return;
    }
}
